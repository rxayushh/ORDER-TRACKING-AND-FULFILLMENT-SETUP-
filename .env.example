# =========================================================================
# Order Tracking & Warehouse Fulfillment Setup: Environment Variables
# =========================================================================

# Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Local MySQL Database Configuration (Required for the mysql profile / Docker Compose)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ordertrackingdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=ordertracking_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-unique-application-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-mysql-password

# Security & JWT Token
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Optional one-time MySQL first-admin bootstrap. Use a unique password of 12+ characters,
# then remove these two variables after the first successful startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:8080/api
